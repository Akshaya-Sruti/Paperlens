# Optional. Defaults work for local development.
# Additional frontend origins (comma-separated) allowed to call the API.
# CORS_ORIGINS=http://localhost:5173
# Extra frontend URL appended to the default dev origins.
# FRONTEND_URL=
# Where processed papers are stored (default: backend/data).
# PAPERLENS_DATA_DIR=

# ── Stage 5: AI analysis (OpenAI) ──────────────────────────────────
# Required to generate paper analysis. Never commit a real key.
# The key stays on the server — it is never sent to the browser.
# OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
