# Optional. Defaults work for local development.
# Additional frontend origins (comma-separated) allowed to call the API.
# CORS_ORIGINS=http://localhost:5173
# Extra frontend URL appended to the default dev origins.
# FRONTEND_URL=
# Where processed papers are stored (default: backend/data).
# PAPERLENS_DATA_DIR=

# ── Stage 5: AI analysis ───────────────────────────────────────────
# Active provider: "gemini" (default) or "openai".
# AI_PROVIDER=gemini
#
# Gemini (active). Free tier works with the default model.
# Put the real key only in backend/.env — never commit it, never send it
# to the browser. All AI calls follow Frontend → FastAPI → provider.
# GEMINI_API_KEY=YOUR_KEY_HERE
# Optional model override (default: gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash
#
# OpenAI (optional legacy provider; only needed if AI_PROVIDER=openai).
# The key stays on the server and is never exposed to the frontend.
# OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
